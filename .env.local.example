# Copy this file to .env.local and fill in your own values.

# Server-only TMDB v3 API key (required). Never prefix with NEXT_PUBLIC_.
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional: canonical production URL used for metadata, sitemap and Open Graph tags.
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Optional: only used by the client-side "API Explorer" playground (src/app/api-explorer)
# to run live requests in the browser. Leave unset to keep the explorer in
# "bring your own key" mode.
# NEXT_PUBLIC_TMDB_EXPLORER_KEY=

# Optional, server-only: enables IMDb/Rotten Tomatoes/Metacritic ratings on movie & TV
# pages via OMDb (TMDB has no cross-source rating data of its own). Free key, 1,000
# req/day: https://www.omdbapi.com/apikey.aspx. Leave unset to hide this section — no
# code path depends on it being present.
# OMDB_API_KEY=
